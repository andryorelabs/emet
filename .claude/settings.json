{
  "permissions": {
    "allow": [
      "Bash(bun run check)",
      "Bash(bun run test)",
      "Bash(bun run fix)",
      "Bash(bun run format:write)",
      "Bash(bun run format:check)",
      "Bash(bun run lint)",
      "Bash(bun run lint:docs)",
      "Bash(bun run typecheck)",
      "Bash(bun run knip)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(emet:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin develop:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin HEAD:develop:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/rm-guard.ts\""
          }
        ]
      }
    ]
  }
}
