{
  "extends": ["astro/tsconfigs/strict", "../../tsconfig.base.json"],
  "compilerOptions": {
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "playwright.config.ts",
    "src/**/*",
    "scripts/**/*",
    "e2e/**/*"
  ],
  "exclude": ["node_modules", "dist"],
  "contentMappers": [
    {
      "package": "@astrojs/ts-content-mapper",
      "extensions": [".astro"]
    }
  ]
}
