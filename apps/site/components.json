{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/styles/global.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@magicui": "https://magicui.design/r/{name}.json",
    "@tinkerers": "https://ui.tinkererslabs.com/r/{name}.json",
    "@kokonutui": "https://kokonutui.com/r/{name}.json",
    "@hairline": "https://hairlineui.com/r/{name}.json",
    "@keyframeui": "https://keyframeui.com/r/{name}.json"
  }
}
