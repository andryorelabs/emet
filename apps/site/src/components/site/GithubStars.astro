---
/**
 * The content of the header GitHub link with a compact star count. `header` is
 * the desktop pill: the mark and the count; `menu` is the mobile menu row: the
 * word and the count. The build bakes the count in; a bundled script refreshes
 * it from the same-origin proxy. Without a build count the link shows the mark
 * alone and the count stays hidden until the refresh succeeds.
 */
import type { Locale } from "../../i18n/locales";
import { badgeVariants } from "../ui/badge";
import { buttonVariants } from "../ui/button";
import { formatStarCount, getBuildStarCount } from "./github-stars";
import { GITHUB_STARS_TOOLTIP, starsTooltip } from "./github-strings";

interface Props {
  locale: Locale;
  label: string;
  placement: "header" | "menu";
}

const { locale, label, placement } = Astro.props;
const count = await getBuildStarCount();
---

<span
  data-slot="button"
  class:list={["github-stars", `github-stars--${placement}`, buttonVariants({ variant: "ghost" })]}
  lang={locale}
  title={count === null ? undefined : starsTooltip(locale, count)}
  data-github-stars-link
  data-stars-template={GITHUB_STARS_TOOLTIP[locale]}
>
  {
    placement === "header" ? (
      <svg class="github-stars-mark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
      </svg>
      <span class="sr-only">{label}</span>
    ) : (
      <span>{label}</span>
    )
  }
  <span
  data-slot="badge"
  class:list={["github-stars-count", badgeVariants({ variant: "ghost" })]}
  data-github-stars
  hidden={count === null}
>
    {count === null ? "" : formatStarCount(count)}
  </span>
</span>

<script>
  import { refreshStarCounts } from "./github-stars";

  void refreshStarCounts(document);
</script>
