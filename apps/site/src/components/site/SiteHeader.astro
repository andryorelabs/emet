---
/**
 * Website header: the mark and wordmark, a few plain links, the theme selector
 * and the language pill; the home and flow variants add the mobile menu. The `home` variant floats over the hero, `flow` sits in the page flow,
 * `docs` is the one-row docs header with a search slot.
 */
// oxlint-disable-next-line import/no-unassigned-import -- Astro bundles a stylesheet imported for its side effect
import "../../styles/site.css";
// oxlint-disable-next-line import/no-unassigned-import -- Astro bundles a stylesheet imported for its side effect
import "../../styles/header-controls.css";

import mark from "../../assets/mark.svg";
import { localePath, type Locale } from "../../i18n/locales";
import { getStrings } from "../../i18n/ui";
import { en } from "../../i18n/ui/en";
import { externalLinkAttributes } from "../../lib/external-links";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import MobileMenu from "./MobileMenu.astro";
import ThemeSelect from "./ThemeSelect.astro";

interface Props {
  locale: Locale;
  currentPath: string;
  strings?: typeof en.nav;
  variant?: "home" | "flow" | "docs";
}

const { locale, currentPath, strings = en.nav, variant = "home" } = Astro.props;
const docsPath = localePath(locale, "/docs/");
const whatsNewPath = localePath(locale, "/docs/whats-new/");
const onWhatsNew = currentPath.startsWith("/docs/whats-new/");
const onDocs = currentPath.startsWith("/docs/") && !onWhatsNew;
const { theme, links: linkStrings } = getStrings(locale);
const githubUrl = "https://github.com/andryorelabs/emet";
const links = [
  { href: docsPath, label: strings.docs, current: onDocs },
  { href: whatsNewPath, label: strings.whatsNew, current: onWhatsNew },
  { href: githubUrl, label: strings.github, current: false },
];
---

<header class:list={["site-header", `site-header--${variant}`]}>
  <a class="wordmark" href={localePath(locale, "/")} aria-label={strings.home}>
    <img src={mark.src} width="30" height="30" alt="" />
    <span>emet</span>
  </a>
  <nav aria-label={strings.label}>
    <a href={docsPath} aria-current={onDocs ? "page" : undefined}>{strings.docs}</a>
    <a href={whatsNewPath} aria-current={onWhatsNew ? "page" : undefined}>{strings.whatsNew}</a>
    <a href={githubUrl} {...externalLinkAttributes(githubUrl)}>
      {strings.github}<span class="sr-only">{linkStrings.newTab}</span>
    </a>
  </nav>
  <div class="site-header-end">
    <slot name="search" />
    <ThemeSelect labels={theme} />
    <LanguageSwitcher locale={locale} currentPath={currentPath} label={strings.language} />
    {
      variant !== "docs" && (
        <MobileMenu
          locale={locale}
          currentPath={currentPath}
          strings={strings}
          theme={theme}
          links={links}
        />
      )
    }
  </div>
</header>
