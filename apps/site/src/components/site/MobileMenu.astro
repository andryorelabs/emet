---
/**
 * Shell of the mobile menu of the home and flow headers, shown below 900px
 * where the nav links hide: it mounts the `MobileMenu` sheet island and slots
 * the server-rendered language and theme controls into it. Desktop header
 * controls stay until the page marks the header's menu as ready.
 */
import type { Locale } from "../../i18n/locales";
import { getStrings } from "../../i18n/ui";
import type { en } from "../../i18n/ui/en";
import { isExternalHref } from "../../lib/external-links";
import { formatStarCount, getBuildStarCount } from "./github-stars";
import { GITHUB_STARS_TOOLTIP, starsTooltip } from "./github-strings";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { MobileMenu } from "./MobileMenu.tsx";
import ThemeSelect from "./ThemeSelect.astro";

interface Props {
  locale: Locale;
  currentPath: string;
  strings: typeof en.nav;
  theme: typeof en.theme;
  links: { href: string; label: string; current: boolean; stars?: boolean }[];
}

const { locale, currentPath, strings, theme, links } = Astro.props;
const { newTab } = getStrings(locale).links;
const count = await getBuildStarCount();
const stars = {
  count: count === null ? null : formatStarCount(count),
  tooltip: count === null ? null : starsTooltip(locale, count),
  template: GITHUB_STARS_TOOLTIP[locale],
};
const menuLinks = links.map((link) => ({
  href: link.href,
  label: link.label,
  current: link.current,
  external: isExternalHref(link.href),
  stars: link.stars ? stars : undefined,
}));
const labels = { menu: strings.menu, navigation: strings.label, newTab };
---

<div class="mobile-menu" data-mobile-menu>
  <MobileMenu client:interaction links={menuLinks} locale={locale} labels={labels}>
    <LanguageSwitcher locale={locale} currentPath={currentPath} label={strings.language} />
    <ThemeSelect labels={theme} />
  </MobileMenu>
</div>

<script>
  document.querySelector("[data-mobile-menu]")?.closest(".site-header")?.setAttribute("data-menu-ready", "");
</script>
