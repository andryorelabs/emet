---
/**
 * Language menu shell: mounts the `LanguageMenu` island, which hydrates on
 * first interaction. The wrapper keeps the `lang` hook the header layout uses,
 * and a `noscript` `details` of plain links keeps switching language possible
 * without script.
 */
import { LOCALES, LOCALE_NAMES, localePath, type Locale } from "../../i18n/locales";
import { LanguageMenu } from "./LanguageMenu";


interface Props {
  locale: Locale;
  currentPath: string;
  label?: string;
}

const { locale, currentPath, label = "Language" } = Astro.props;
---

<div class="lang">
  <LanguageMenu client:interaction locale={locale} currentPath={currentPath} labels={{ label }} />
  <noscript>
    <details>
      <summary aria-label={`${label}: ${LOCALE_NAMES[locale]}`}>
        <span>{LOCALE_NAMES[locale]}</span><span class="lang-caret" aria-hidden="true">▾</span>
      </summary>
      <ul>
        {
          LOCALES.map((target) => (
            <li>
              <a
                href={localePath(target, currentPath)}
                hreflang={target}
                lang={target}
                aria-current={target === locale ? "true" : undefined}
              >
                <span>{LOCALE_NAMES[target]}</span>
                <span class="lang-code" lang="en">
                  {target}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </noscript>
</div>
