---
/**
 * Language pill and menu for the current page. A `details` of plain links, one
 * per locale, each with its native name and its code; it works without script.
 */
import { LOCALES, LOCALE_NAMES, localePath, type Locale } from "../../i18n/locales";

interface Props {
  locale: Locale;
  currentPath: string;
  label?: string;
}

const { locale, currentPath, label = "Language" } = Astro.props;
---

<details class="lang">
  <summary aria-label={`${label}: ${LOCALE_NAMES[locale]}`}>
    <span>{LOCALE_NAMES[locale]}</span><span class="lang-caret" aria-hidden="true">▾</span>
  </summary>
  <ul>
    {
      LOCALES.map((target) => (
        <li>
          <a
            href={localePath(target, currentPath)}
            hreflang={target}
            lang={target}
            aria-current={target === locale ? "true" : undefined}
          >
            <span>{LOCALE_NAMES[target]}</span>
            <span class="lang-code" lang="en">
              {target}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</details>
