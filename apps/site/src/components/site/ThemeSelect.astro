---
/**
 * Theme selector shell: mounts the `ThemeMenu` island, which hydrates on first
 * interaction. The wrapper keeps the `theme-select` hook the header layout uses.
 */
// oxlint-disable-next-line import/no-unassigned-import -- Astro bundles a stylesheet imported for its side effect
import "../../styles/header-controls.css";

import type { en } from "../../i18n/ui/en";
import { ThemeMenu } from "./ThemeMenu";

interface Props {
  labels: typeof en.theme;
  id?: string;
}

const { labels } = Astro.props;
---

<div class="theme-select">
  <ThemeMenu client:interaction labels={labels} />
</div>
