---
/**
 * Website footer: the brand block on the left, a Product and a Trust column of
 * links grouped on the right, then one bottom row with the legal line, the AI
 * disclosure of the paintings and the author credit.
 */
// oxlint-disable-next-line import/no-unassigned-import -- Astro bundles a stylesheet imported for its side effect
import "../../styles/site.css";

import { Separator } from "@/components/ui/separator";
import mark from "../../assets/mark.svg";
import { localePath, type Locale } from "../../i18n/locales";
import { getStrings } from "../../i18n/ui";
import { en } from "../../i18n/ui/en";
import { externalLinkAttributes, isExternalHref } from "../../lib/external-links";

interface Props {
  locale: Locale;
  strings?: typeof en.footer;
  currentPath?: string;
}

const REPOSITORY_URL = "https://github.com/andryorelabs/emet";
const AUTHOR_URL = "https://andryore.dev";

const { locale, strings = en.footer } = Astro.props;
const { newTab } = getStrings(locale).links;

const columns = [
  {
    id: "footer-product",
    heading: strings.product,
    links: [
      { href: localePath(locale, "/docs/"), label: strings.docs },
      { href: localePath(locale, "/docs/whats-new/"), label: strings.whatsNew },
      { href: REPOSITORY_URL, label: strings.github },
    ],
  },
  {
    id: "footer-trust",
    heading: strings.trust,
    links: [
      { href: `${REPOSITORY_URL}/actions/workflows/ci.yml`, label: strings.ci },
      { href: "https://www.bestpractices.dev/projects/16352", label: strings.openssf },
      { href: `${REPOSITORY_URL}/blob/main/.github/SECURITY.md`, label: strings.security },
      { href: `${REPOSITORY_URL}/blob/main/CONTRIBUTING.md`, label: strings.contributing },
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-brand">
      <a class="footer-wordmark" href={localePath(locale, "/")}>
        <img src={mark.src} width="24" height="24" alt="" />
        <span>emet</span>
      </a>
      <p>{strings.description}</p>
    </div>
    <div class="footer-columns">
    {
      columns.map((column) => (
        <nav class="footer-column" aria-labelledby={column.id}>
          <p class="footer-heading" id={column.id}>
            {column.heading}
          </p>
          <ul>
            {column.links.map((link) => (
              <li>
                <a class="footer-link" href={link.href} {...externalLinkAttributes(link.href)}>
                  {link.label}
                  {isExternalHref(link.href) && <span class="sr-only">{newTab}</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
    </div>
  </div>
  <Separator className="mt-10" />
  <div class="footer-bottom">
    <span>{strings.legal} {strings.notice}</span>
    <span>{strings.paintings}</span>
    <a href={AUTHOR_URL} {...externalLinkAttributes(AUTHOR_URL, "author")}
      >{strings.builtBy}<span class="sr-only">{newTab}</span></a
    >
  </div>
</footer>
