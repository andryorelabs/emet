---
/**
 * Website footer: one quiet block with the plugin line, the Anthropic notice
 * and the AI disclosure of the paintings.
 */
import { localePath, type Locale } from "../../i18n/locales";
import { en } from "../../i18n/ui/en";

interface Props {
  locale: Locale;
  strings?: typeof en.footer;
}

const { locale, strings = en.footer } = Astro.props;
---

<footer class="site-footer">
  <p class="footer-line">
    <strong>emet</strong>
    <span>{strings.description}</span>
    <span>{strings.notice}</span>
  </p>
  <nav class="footer-links">
    <a href={localePath(locale, "/docs/")}>{strings.docs}</a>
    <a href={localePath(locale, "/docs/whats-new/")}>{strings.whatsNew}</a>
    <a href="https://github.com/andryorelabs/emet">{strings.github}</a>
  </nav>
  <p class="footer-fine">{strings.legal} {strings.paintings}</p>
</footer>
