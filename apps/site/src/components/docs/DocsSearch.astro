---
/**
 * Starlight's Pagefind search, served from the site's own origin, with the
 * Trusted Types policy that lets only its `<mark>` excerpts and its worker
 * through, and the shadcn dialog island (`DocsSearch.tsx`) that adopts
 * Pagefind's container while open. Starlight's own dialog never opens: the
 * small script routes its open button, Ctrl K and `/` to the island. The same
 * script localizes and animates the copy button of every code block.
 * It takes the locale as a prop and, with `standalone`, fills in the
 * translator Starlight's `Search` reads, so it also works on the home page.
 * The header's search bar opens it; Starlight's own button stays hidden.
 */
import Search from "@astrojs/starlight/components/Search.astro";

import { SEARCH_STRINGS, SEARCH_TERM_TOKEN } from "../../docs/search-strings";
import type { Locale } from "../../i18n/locales";
import SearchButton from "../site/SearchButton.astro";
import { DocsSearch as DocsSearchDialog } from "./DocsSearch";
// oxlint-disable-next-line import/no-unassigned-import -- Astro bundles a stylesheet imported for its side effect
import "../../styles/search-dialog.css";

interface Props {
  locale: Locale;
  standalone?: boolean;
}

const { locale, standalone = false } = Astro.props;
const strings = SEARCH_STRINGS[locale];
if (standalone) {
  const standaloneMessages: Record<string, string> = {
    "search.label": strings.searchButtonLabel,
    "search.ctrlKey": "Ctrl",
    "search.cancelLabel": strings.cancel,
    "search.devWarning": "Search is only available in production builds.",
  };
  const translate = Object.assign((key: string): string => standaloneMessages[key] ?? key, {
    all: (): Record<string, string> => ({}),
  });
  Astro.locals.t = translate as unknown as typeof Astro.locals.t;
}
const pagefindOverrides = {
  "pagefind.placeholder": strings.placeholder,
  "pagefind.searching": strings.searching,
  "pagefind.zero_results": strings.noResults(SEARCH_TERM_TOKEN),
};
const baseDictionary = Astro.locals.t.all.bind(Astro.locals.t);
Astro.locals.t.all = () => ({ ...baseDictionary(), ...pagefindOverrides });

const clientStrings = { copy: strings.copy, copied: strings.copied };
const dialogStrings = {
  label: strings.searchButtonLabel,
  cancel: strings.cancel,
  token: SEARCH_TERM_TOKEN,
  searching: strings.searching,
  noResults: strings.noResults(SEARCH_TERM_TOKEN),
  footerPrivacy: strings.footerPrivacy,
  footerKeys: strings.footerKeys,
  escapeKey: strings.escapeKey,
};
---

<SearchButton locale={locale} />
<div
  class:list={["docs-search", standalone && "docs-search--standalone"]}
  data-docs-search={JSON.stringify(clientStrings)}
>
  <Search />
</div>
<DocsSearchDialog client:idle strings={dialogStrings} standalone={standalone} />

<script>
  import {
    installSearchTrustedTypesPolicy,
    type TrustedTypesFactory,
  } from "../../docs/search-trusted-types";
  import {
    SEARCH_PENDING_ATTRIBUTE,
    SEARCH_REQUEST_EVENT,
    type SearchRequestMode,
  } from "../../docs/search-markup";
  import { isSearchSlashKey, isSearchToggleKey } from "../site/search-shortcut";

  interface ClientStrings {
    copy: string;
    copied: string;
  }

  const COPIED_STATE_MS = 2000;
  const STARLIGHT_OPEN_BUTTON = "site-search button[data-open-modal]";
  const DIALOG_SELECTOR = '[data-search-part="dialog"]';

  installSearchTrustedTypesPolicy(
    (globalThis as { trustedTypes?: TrustedTypesFactory }).trustedTypes,
    globalThis.location.origin,
  );

  function requestSearch(root: Element, mode: SearchRequestMode): void {
    root.setAttribute(SEARCH_PENDING_ATTRIBUTE, mode);
    root.dispatchEvent(new CustomEvent<SearchRequestMode>(SEARCH_REQUEST_EVENT, { detail: mode }));
  }

  function takeOverSearchTriggers(root: Element): void {
    window.addEventListener(
      "click",
      (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (!target?.closest(STARLIGHT_OPEN_BUTTON)) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        requestSearch(root, "open");
      },
      true,
    );
    window.addEventListener(
      "keydown",
      (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (isSearchToggleKey(event)) {
          event.preventDefault();
          event.stopImmediatePropagation();
          requestSearch(root, "toggle");
        } else if (!document.querySelector(DIALOG_SELECTOR) && isSearchSlashKey(event, target)) {
          event.preventDefault();
          requestSearch(root, "open");
        }
      },
      true,
    );
  }

  const copiedTimers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();

  function enhanceCopyButtons(strings: ClientStrings): void {
    for (const button of document.querySelectorAll<HTMLElement>(".expressive-code .copy button")) {
      button.setAttribute("aria-label", strings.copy);
      button.setAttribute("title", strings.copy);
      button.dataset.copied = strings.copied;
    }
    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const button = target?.closest<HTMLElement>(".expressive-code .copy button");
      if (!button) return;
      button.dataset.state = "copied";
      button.setAttribute("aria-label", strings.copied);
      clearTimeout(copiedTimers.get(button));
      copiedTimers.set(
        button,
        setTimeout(() => {
          delete button.dataset.state;
          button.setAttribute("aria-label", strings.copy);
        }, COPIED_STATE_MS),
      );
    });
  }

  const root = document.querySelector<HTMLElement>("[data-docs-search]");
  if (root?.dataset.docsSearch) {
    const strings = JSON.parse(root.dataset.docsSearch) as ClientStrings;
    takeOverSearchTriggers(root);
    enhanceCopyButtons(strings);
  }
</script>
