---
/**
 * Docs header: the Website's own header, then the Pagefind search button.
 */
import { englishPathOf, resolveLocale } from "../../docs/route";
import { getStrings } from "../../i18n/ui";
import SiteHeader from "../site/SiteHeader.astro";
import DocsSearch from "./DocsSearch.astro";

const { lang } = Astro.locals.starlightRoute;
const locale = resolveLocale(lang);
const currentPath = englishPathOf(Astro.url.pathname, locale);
---

<div class="docs-header">
  <SiteHeader locale={locale} currentPath={currentPath} strings={getStrings(locale).nav} />
  <DocsSearch />
</div>
