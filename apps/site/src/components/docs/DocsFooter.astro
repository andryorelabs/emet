---
/**
 * Docs footer: Starlight's edit link and pagination, then the Website footer.
 */
import StarlightFooter from "@astrojs/starlight/components/Footer.astro";

import { englishPathOf, resolveLocale } from "../../docs/route";
import { getStrings } from "../../i18n/ui";
import SiteFooter from "../site/SiteFooter.astro";

const { lang } = Astro.locals.starlightRoute;
const locale = resolveLocale(lang);
const currentPath = englishPathOf(Astro.url.pathname, locale);
---

<StarlightFooter />
<div class="docs-site-footer">
  <SiteFooter locale={locale} strings={getStrings(locale).footer} currentPath={currentPath} />
</div>
