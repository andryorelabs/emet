---
/**
 * The docs title row's actions. The shell resolves the Markdown twin and page
 * URLs and the locale's labels, then mounts the `PageActions` island.
 */
import { markdownTwinPath } from "../../docs/markdown-twin";
import { PAGE_ACTIONS_STRINGS } from "../../docs/page-actions-strings";
import type { Locale } from "../../i18n/locales";
import { PageActions } from "./PageActions";

interface Link {
  href: string;
  label: string;
}

interface Props {
  pageId: string;
  locale: Locale;
  prev?: Link | undefined;
  next?: Link | undefined;
}

const { pageId, locale, prev, next } = Astro.props;
const labels = PAGE_ACTIONS_STRINGS[locale];
const markdownUrl = markdownTwinPath(pageId);
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<PageActions client:idle markdownUrl={markdownUrl} pageUrl={pageUrl} labels={labels} prev={prev} next={next} />
