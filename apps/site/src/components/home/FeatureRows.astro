---
/**
 * Five more claims as compact cards under the bento: the claim and the
 * run-report line it leaves behind, each linking to the docs page that covers
 * it. No paragraph, no pictures and no motion. Commands, flags and report keys
 * are not translated; only the claim is.
 */
import type { UiStrings } from "../../i18n/ui/en";
import { DEFAULT_LOCALE, localePath, LOCALES, localeSegment } from "../../i18n/locales";
import { Card, CardContent, CardHeader, CardTitle } from "../ui/card";
import { Kbd } from "../ui/kbd";

interface Props {
  strings: UiStrings;
}

const { strings } = Astro.props;
const { features } = strings;
const locale =
  LOCALES.find(
    (candidate) =>
      candidate !== DEFAULT_LOCALE && Astro.url.pathname.startsWith(`/${localeSegment(candidate)}/`),
  ) ?? DEFAULT_LOCALE;

const reports = [
  { key: "/emet:run", value: "--quick" },
  { key: "lessons", value: "saved 3 · recalled 2" },
  { key: "review", value: "high · 2 reviewers · 0 open findings" },
  { key: "attention", value: "waiting for approval" },
  { key: "emet uninstall --dry-run", value: "14 files would be removed" },
];
---

<li class="bento-compact">
<ul class="feature-rows">
  {
    features.extra.map((note, index) => {
      const report = reports[index];
      return (
        report && (
          <li class="feature-row" data-reveal="item">
            <a class="feature-link" href={localePath(locale, note.docs)}>
              <Card size="sm">
                <CardHeader>
                  <CardTitle>
                    <h3>{note.title}</h3>
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <Kbd className="h-auto whitespace-normal break-words">
                    <span class="feature-key">{report.key}</span> {report.value}
                  </Kbd>
                </CardContent>
              </Card>
            </a>
          </li>
        )
      );
    })
  }
</ul>
</li>

<style>
  .bento-compact {
    min-width: 0;
  }

  .feature-rows {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feature-row:nth-child(5) {
    grid-column: 1 / -1;
  }

  .feature-link :global([data-slot="card"]) {
    height: 100%;
  }

  @media (min-width: 761px) {
    .bento-compact {
      grid-column: 5 / 13;
      grid-row: 3;
    }

    .feature-rows {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(3, auto);
      align-content: stretch;
    }
  }

  @media (min-width: 761px) and (max-width: 1100px) {
    .bento-compact {
      grid-column: 6 / 13;
    }
  }

  .feature-row {
    min-width: 0;
  }

  .feature-link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-panel);
  }

  .feature-row h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .feature-key {
    color: var(--accent-text);
  }
</style>
