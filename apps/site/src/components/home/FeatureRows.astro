---
/**
 * Five more claims as plain rows under the bento: the claim, one line, and
 * the run-report line it leaves behind. No pictures and no motion. Commands,
 * flags and report keys are not translated; only the claim and its line are.
 */
import type { UiStrings } from "../../i18n/ui/en";

interface Props {
  strings: UiStrings;
}

const { strings } = Astro.props;
const { features } = strings;

const reports = [
  { key: "/emet:run", value: "--quick" },
  { key: "lessons", value: "saved 3 · recalled 2" },
  { key: "review", value: "high · 2 reviewers · 0 open findings" },
  { key: "attention", value: "waiting for approval" },
  { key: "emet uninstall --dry-run", value: "14 files would be removed" },
];
---

<ul class="feature-rows">
  {
    features.extra.map((note, index) => {
      const report = reports[index];
      return (
        report && (
          <li class="feature-row" data-reveal="item">
            <h3>{note.title}</h3>
            <p>{note.line}</p>
            <pre class="feature-report"><span class="feature-key">{report.key}</span>{`  ${report.value}`}</pre>
          </li>
        )
      );
    })
  }
</ul>

<style>
  .feature-rows {
    max-width: 960px;
    margin: 48px 0 0 var(--axis);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .feature-row {
    display: grid;
    gap: 4px;
    min-width: 0;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
  }

  .feature-row h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .feature-row p {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .feature-report {
    margin: 12px 0 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    overflow-wrap: anywhere;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 13px;
    line-height: 1.7;
    white-space: pre-wrap;
  }

  .feature-key {
    color: var(--accent-text);
  }

  @media (max-width: 1100px) {
    .feature-rows {
      margin-left: 0;
    }
  }
</style>
