---
/**
 * The FAQ between About and the closing panel: the `FaqAccordion` island with the first
 * question open and a link to the localized troubleshooting page.
 */
import type { Locale } from "../../i18n/locales";
import { localePath } from "../../i18n/locales";
import type { UiStrings } from "../../i18n/ui/en";
import { FaqAccordion } from "./FaqAccordion";

interface Props {
  strings: UiStrings;
  locale: Locale;
}

const { strings, locale } = Astro.props;
const { faq } = strings;
const troubleshootingPath = localePath(locale, "/docs/troubleshooting/");
---

<FaqAccordion client:visible items={faq.items} heading={faq.heading} more={faq.more} href={troubleshootingPath} />
