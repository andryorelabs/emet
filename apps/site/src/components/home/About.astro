---
/**
 * Founder's letter beside the painted portrait of the golem.
 */
import { Picture } from "astro:assets";

import portraitImage from "../../assets/portrait.webp";
import type { UiStrings } from "../../i18n/ui/en";

interface Props {
  strings: UiStrings;
}

const { strings } = Astro.props;
const { about } = strings;
---

<section class="about" data-drift aria-labelledby="about-title">
  <div class="letter">
    <h2 id="about-title" data-reveal="heading"><span class="reveal-line">{about.heading}</span></h2>
    <p>{about.lineOne}</p>
    <div class="hebrew-pair" data-reveal="item" role="img" aria-label={about.wordLabel}>
      <div class="hebrew-word" aria-hidden="true">
        <span class="hebrew" lang="he" dir="rtl"><span class="hebrew-aleph">א</span>מת</span>
        <span class="hebrew-roman">emet</span>
        <span class="hebrew-gloss">{about.truth}</span>
      </div>
      <span class="hebrew-arrow" aria-hidden="true">→</span>
      <div class="hebrew-word" aria-hidden="true">
        <span class="hebrew" lang="he" dir="rtl">מת</span>
        <span class="hebrew-roman">met</span>
        <span class="hebrew-gloss">{about.dead}</span>
      </div>
    </div>
    <p>{about.lineTwo}</p>
    <p class="signature">AndryOre<small>{about.role}</small></p>
  </div>
  <figure class="portrait">
    <Picture
      src={portraitImage}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[640, 1024]}
      sizes="(min-width: 1001px) 420px, 100vw"
      alt={about.alt}
      loading="lazy"
      decoding="async"
    />
    <figcaption>{about.caption}</figcaption>
  </figure>
</section>
