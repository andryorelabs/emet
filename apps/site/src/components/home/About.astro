---
/**
 * Founder's letter beside the painted portrait of the golem.
 */
import { Picture } from "astro:assets";

import portraitImage from "../../assets/portrait.webp";
import type { UiStrings } from "../../i18n/ui/en";

interface Props {
  strings: UiStrings;
}

const { strings } = Astro.props;
const { about } = strings;
---

<section class="about" data-drift aria-labelledby="about-title">
  <div class="letter">
    <h2 id="about-title" data-reveal="heading"><span class="reveal-line">{about.heading}</span></h2>
    <div class="hebrew-pair" data-reveal="item" role="img" aria-label={about.wordLabel}>
      <div class="hebrew-word" aria-hidden="true">
        <span class="hebrew" lang="he" dir="rtl"><span class="hebrew-aleph">א</span>מת</span>
        <span class="hebrew-glosses"><span>{about.truth}</span><span>{about.dead}</span></span>
      </div>
      <span class="latin" aria-hidden="true"><span class="latin-e">e</span>met</span>
    </div>
    <p>{about.lineOne}</p>
    <p class="mute">{about.lineTwoBefore}<span class="mark">{about.flag}</span>{about.lineTwoAfter}</p>
  </div>
  <figure class="portrait">
    <div class="portrait-frame">
      <Picture
        src={portraitImage}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        widths={[640, 1024]}
        sizes="(min-width: 1001px) 420px, 100vw"
        alt={about.alt}
        loading="lazy"
          decoding="async"
      />
      <canvas data-pixel-reveal aria-hidden="true"></canvas>
    </div>
    <figcaption><span>{about.caption}</span><span>{about.role}</span></figcaption>
  </figure>
</section>

<script>
  // oxlint-disable-next-line import/no-unassigned-import -- the module wires itself to the page
  import "./about/about";
  import { initAboutFx } from "./about/fx";

  const portrait = document.querySelector<HTMLElement>(".portrait-frame");
  const reveal = portrait?.querySelector<HTMLCanvasElement>("canvas[data-pixel-reveal]");
  if (portrait) {
    initAboutFx(portrait, () => reveal?.dataset.state === "done");
  }
</script>
