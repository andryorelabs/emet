---
/**
 * One plate: a run report with six notes in its margin, one per claim.
 */
import type { UiStrings } from "../../i18n/ui/en";

interface Props {
  strings: UiStrings;
}

const { strings } = Astro.props;
const { features } = strings;

const blocks = [
  "approval  spec 252, 4 tickets\n          given once",
  "workers   3 in 3 worktrees\n          done",
  "review    wave 2\n          clear",
  "flags     0\n          none",
  "ci        PR #266\n          passing",
  "merge     develop\n          merged",
];
---

<section class="features" aria-labelledby="features-title" data-features>
  <h2 id="features-title" data-reveal="heading">
    <span class="reveal-line">{features.heading}</span>
  </h2>
  <div class="plate" data-plate>
    <div class="fragment" data-ui data-reveal="item">
      {blocks.map((block, index) => <pre class="terminal block" data-block={index}>{block}</pre>)}
    </div>
  </div>
  <ul class="notes">
    {
      features.notes.map((note, index) => (
        <li
          class="note"
          data-block={index}
          data-side={index < 3 ? "left" : "right"}
          data-reveal="item"
          tabindex="0"
        >
          <h3>{note.title}</h3>
          <p>{note.line}</p>
        </li>
      ))
    }
  </ul>
</section>

<script>
  import { initFeatureNotes } from "./graphics/feature-notes";

  initFeatureNotes(document);
</script>
