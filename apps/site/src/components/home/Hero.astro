---
/**
 * First screen: the painted valley fills the viewport, the headline rises from
 * a mask around the golem and its letters warm toward amber near the pointer, the painting zooms with the scroll, the sentence and actions sit on the left. The picture is preloaded.
 */
import { getImage, Picture } from "astro:assets";

import heroImage from "../../assets/hero.webp";
import type { UiStrings } from "../../i18n/ui/en";
import AnnouncementPill from "./AnnouncementPill.astro";
import Valley from "./graphics/Valley.astro";
// oxlint-disable-next-line import/no-unassigned-import -- Astro bundles a stylesheet imported for its side effect
import "../../styles/motion.css";

interface Props {
  strings: UiStrings;
}

const { strings } = Astro.props;
const widths = [640, 1024, 1672];
const variants = await Promise.all(
  widths.map((width) => getImage({ src: heroImage, width, format: "avif" })),
);
const preloadSrcset = variants.map((variant) => `${variant.src} ${variant.options.width}w`).join(", ");
const { hero } = strings;
const phrases = JSON.stringify([
  strings.showcase.statusHeld,
  strings.showcase.status,
  strings.how.caption,
  hero.lineTwo,
]);
---

<link
  rel="preload"
  as="image"
  type="image/avif"
  imagesrcset={preloadSrcset}
  imagesizes="100vw"
  fetchpriority="high"
/>
<section class="hero" data-zoom data-phrases={phrases} aria-labelledby="hero-title">
  <Picture
    class="hero-picture"
    src={heroImage}
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    widths={widths}
    sizes="100vw"
    alt={hero.alt}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <Valley variant="hero" />
  <div class="hero-rays" aria-hidden="true"></div>
  <svg class="hero-grain" aria-hidden="true" focusable="false">
    <filter id="hero-grain-noise">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch"></feTurbulence>
    </filter>
    <rect width="100%" height="100%" filter="url(#hero-grain-noise)"></rect>
  </svg>
  <div class="hero-light" data-hero-light hidden aria-hidden="true"></div>
  <canvas class="hero-fireflies" data-hero-fireflies hidden aria-hidden="true"></canvas>
  <button class="hero-golem" data-hero-golem type="button" hidden aria-describedby="hero-bubble">
    <span class="sr-only">{hero.name}</span>
  </button>
  <p class="hero-bubble" id="hero-bubble" data-hero-bubble role="status"></p>
  <div class="hero-copy">
    <h1 id="hero-title">
      <span class="sr-only">{hero.name}. </span>
      <span class="hero-line hero-line-one"><span data-letters>{hero.lineOne}</span></span>
      <span class="hero-line hero-line-two"><span data-letters>{hero.lineTwo}</span></span>
    </h1>
    <div class="hero-mid">
      <AnnouncementPill label={strings.nav.whatsNew} />
      <p class="hero-sentence">{hero.sentence}</p>
      <div class="hero-actions">
        <a class="button" href="#install">{hero.install}</a>
        <a class="text-link" href="/docs/">{hero.readDocs}</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { initAmbient } from "./graphics/ambient";
  import { initHeroFx } from "./hero-fx";
  import { initLetters } from "./hero-fx/letters";
  import { initMotion } from "./motion/motion";

  initMotion(document);
  initAmbient(document);
  const heroSection = document.querySelector<HTMLElement>(".hero");
  if (heroSection) {
    initHeroFx(heroSection);
    initLetters(heroSection);
  }
</script>
