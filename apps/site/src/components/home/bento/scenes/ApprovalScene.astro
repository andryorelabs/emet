---
/**
 * Approval card picture: four tickets, an Approve button with a cursor, and the
 * stamp. The markup is the static final frame (approved tickets and the
 * stamp); the loop in `approval.css` starts from skeletons and ends there.
 * The tickets, cursor and stamp are decorative and `aria-hidden`; the Approve
 * button is a real control that script wires for hold-to-approve, and it stays
 * `inert` until then.
 */
// oxlint-disable-next-line import/no-unassigned-import -- Astro bundles a stylesheet imported for its side effect
import "../../../../styles/bento/scene.css";
// oxlint-disable-next-line import/no-unassigned-import -- Astro bundles a stylesheet imported for its side effect
import "../../../../styles/bento/approval.css";
import { sceneLabels } from "../interact/labels";

const tickets = ["monorepo scaffold", "home layout", "code blocks", "docker and deploy"];
const labels = sceneLabels.approval;
---

<div
  class="scene scene-approval bento-visual"
  data-scene
  data-interact="approval"
  data-done-text={labels.done}
>
  <ul class="approval-tickets" aria-hidden="true">
    {
      tickets.map((ticket) => (
        <li>
          <span class="approval-name">
            <span class="approval-skeleton" />
            <span class="approval-text">{ticket}</span>
          </span>
        </li>
      ))
    }
  </ul>
  <div class="approval-footer">
    <button type="button" class="approval-button" aria-label={labels.buttonName} inert>
      <span>{labels.button}</span>
    </button>
    <svg class="approval-cursor" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
      <path d="M1 1l4.5 12 1.8-4.7L12 6.5z"></path>
    </svg>
    <span class="approval-stamp" aria-hidden="true">{labels.done}</span>
  </div>
  <span class="approval-status" role="status"></span>
</div>
