---
/**
 * Flags card picture: three branches flow toward a merge node, a red flag
 * holds them back, then lifts and the node turns green. The static frame
 * (reduced motion or no script) is the finished state. Decorative and
 * `aria-hidden`.
 */
// oxlint-disable-next-line import/no-unassigned-import -- Astro bundles a stylesheet imported for its side effect
import "../../../../styles/bento/scene.css";
// oxlint-disable-next-line import/no-unassigned-import -- Astro bundles a stylesheet imported for its side effect
import "../../../../styles/bento/flags.css";
---

<div class="scene scene-flags bento-visual" data-scene aria-hidden="true">
  <div class="flags-graph">
    <span class="flags-branch"><span class="flags-dash"></span></span>
    <span class="flags-branch"><span class="flags-dash"></span></span>
    <span class="flags-branch"><span class="flags-dash"></span></span>
    <span class="flags-node"><span class="flags-node-lit"></span></span>
    <span class="flags-flag"></span>
  </div>
</div>
