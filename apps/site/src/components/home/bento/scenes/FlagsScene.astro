---
/**
 * Static final frame of the flags card picture: the run track after the flag
 * lifted. Decorative and `aria-hidden`.
 */
// oxlint-disable-next-line import/no-unassigned-import -- Astro bundles a stylesheet imported for its side effect
import "../../../../styles/bento/scene.css";
// oxlint-disable-next-line import/no-unassigned-import -- Astro bundles a stylesheet imported for its side effect
import "../../../../styles/bento/flags.css";
---

<div class="scene scene-flags bento-visual" data-scene aria-hidden="true">
  <div class="flags-run">
    <span class="flags-track"></span>
    <span class="flags-flag">held</span>
  </div>
</div>
