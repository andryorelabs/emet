---
/**
 * The stats band between the features and About sections: four short facts
 * on the 27% axis.
 */
import type { UiStrings } from "../../i18n/ui/en";

interface Props {
  strings: UiStrings;
}

const { strings } = Astro.props;
const { stats } = strings;
---

<section class="stats" aria-label={stats.label}>
  <dl class="stats-grid">
    {
      stats.items.map((item) => (
        <div class="stat" data-reveal="item">
          <dt class="stat-label">{item.label}</dt>
          <dd class="stat-value">{item.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
