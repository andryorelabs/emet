---
/**
 * The stats band between the features and About sections: four short facts
 * on the 27% axis, set as a night band over a topographic canvas. The numeric
 * values roll like an odometer; the fourth item stays static.
 */
import type { UiStrings } from "../../i18n/ui/en";

interface Props {
  strings: UiStrings;
}

const { strings } = Astro.props;
const { stats } = strings;
const isCount = (value: string): boolean => /^\d+$/.test(value);
---

<section class="stats" aria-label={stats.label}>
  <canvas class="stats-topo" data-topo aria-hidden="true"></canvas>
  <dl class="stats-grid">
    {
      stats.items.map((item) => (
        <div class="stat" data-reveal="item" data-n={isCount(item.value) ? item.value : undefined}>
          <dt class="stat-label">{item.label}</dt>
          <dd class="stat-value">
            <span class="stat-text">{item.value}</span>
          </dd>
          <dd class="stat-detail">{item.detail}</dd>
        </div>
      ))
    }
  </dl>
</section>

<script>
  import { initStats } from "./stats";

  initStats(document);
</script>
