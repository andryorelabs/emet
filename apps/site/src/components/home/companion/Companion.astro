---
/**
 * The companion golem: a fixed bottom-right button that shows the golem's
 * state, a status bubble and a four-question menu with fixed answers. It stays
 * hidden until `companion.ts` wakes it, so without script nothing shows.
 */
import { localePath, type Locale } from "../../../i18n/locales";
import type { UiStrings } from "../../../i18n/ui/en";

interface Props {
  strings: UiStrings;
  locale: Locale;
}

const { strings, locale } = Astro.props;
const companion = strings.companion;
const docsHref = localePath(locale, "/docs/");
---

<div
  data-companion
  data-state="sleep"
  data-away=""
  data-sleep={companion.sleep}
  data-work={companion.work}
  data-wait={companion.wait}
  data-done={companion.done}
  hidden
>
  <div data-companion-bubble>
    <p data-companion-say role="status">{companion.sleep}</p>
    <a data-companion-docs href={docsHref} hidden>{companion.docs}</a>
  </div>
  <div data-companion-menu id="companion-menu" role="menu" aria-label={companion.menu} hidden>
    {
      companion.questions.map((item) => (
        <button type="button" role="menuitem" data-answer={item.answer}>
          {item.question}
        </button>
      ))
    }
  </div>
  <button
    type="button"
    data-companion-button
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="companion-menu"
    aria-label={companion.label}
  >
    <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <path data-part="body" d="M9 28Q5 28 5 24L6 14Q6 7 16 7Q26 7 26 14L27 24Q27 28 23 28Z"></path>
      <path data-part="moss" d="M6 14Q6.2 9 10.5 7.6L13 7.3Q12 9.5 10.6 10Q9.6 11.6 10.6 12.6Q8.4 12.2 8 14.6Z"></path>
      <path data-part="sprout" d="M16 7.2V3.6"></path>
      <path data-part="moss" d="M16 4.6Q12.4 1.6 10.6 3.8Q13.4 6.2 16 4.6ZM16 4.6Q19.6 1.4 22 3.4Q19 6.2 16 4.6Z"></path>
      <rect data-part="mouth" x="14" y="20" width="4" height="0.9" rx="0.45"></rect>
      <path
        data-part="moss"
        d="M5.4 24.4L8 23.4L10.4 24.5L13 23.4L16 24.6L19 23.4L21.6 24.5L24 23.4L26.6 24.4L27 24Q27 28 23 28H9Q5 28 5 24Z"
      ></path>
      <g data-part="eyes">
        <g data-eyes="sleep">
          <rect data-part="eye" x="10.6" y="14.7" width="2.8" height="0.8" rx="0.4"></rect>
          <rect data-part="eye" x="18.6" y="14.7" width="2.8" height="0.8" rx="0.4"></rect>
        </g>
        <g data-eyes="work">
          <circle data-part="eye" cx="12" cy="15" r="1.7"></circle>
          <circle data-part="eye" cx="20" cy="15" r="1.7"></circle>
          <circle data-part="glow" cx="12" cy="15" r="3.2"></circle>
          <circle data-part="glow" cx="20" cy="15" r="3.2"></circle>
          <circle data-part="lamp" cx="12" cy="15" r="1"></circle>
          <circle data-part="lamp" cx="20" cy="15" r="1"></circle>
        </g>
        <g data-eyes="wait">
          <circle data-part="eye" cx="12" cy="15" r="1.7"></circle>
          <circle data-part="eye" cx="20" cy="15" r="1.7"></circle>
          <circle data-part="lamp" cx="12.5" cy="14.4" r="1"></circle>
          <circle data-part="lamp" cx="20.5" cy="14.4" r="1"></circle>
        </g>
        <g data-eyes="done">
          <circle data-part="eye" cx="12" cy="15" r="1.7"></circle>
          <circle data-part="eye" cx="20" cy="15" r="1.7"></circle>
          <circle data-part="ok" cx="12" cy="15" r="1"></circle>
          <circle data-part="ok" cx="20" cy="15" r="1"></circle>
        </g>
      </g>
    </svg>
  </button>
</div>

<script>
  import { initCompanion } from "./companion";

  const root = document.querySelector<HTMLElement>("[data-companion]");
  if (root) initCompanion(root);
</script>
