---
/**
 * Waves joining one spec branch: wave 1 and wave 2 each list their tickets
 * and both end in `spec/41`, which the pull request below it lands. Static
 * markup, drawn with borders only: no imagery and no motion.
 */
interface Props {
  waveLabel: (number: number) => string;
  caption: string;
}

const { waveLabel, caption } = Astro.props;

const waves = [
  { number: 1, tickets: ["#42"] },
  { number: 2, tickets: ["#43", "#44", "#45"] },
];
---

<figure class="wave-diagram">
  <ol class="wd-waves">
    {
      waves.map((wave) => (
        <li class="wd-wave">
          <span class="wd-label">{waveLabel(wave.number)}</span>
          <span class="wd-tickets">
            {wave.tickets.map((ticket) => (
              <span class="wd-chip">{ticket}</span>
            ))}
          </span>
        </li>
      ))
    }
  </ol>
  <p class="wd-branch"><span class="wd-chip">spec/41</span></p>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .wave-diagram {
    display: grid;
    gap: 12px;
    min-width: 0;
    margin: 0;
  }

  .wd-waves {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0 0 0 20px;
    list-style: none;
    border-left: 1px solid var(--border);
  }

  .wd-wave {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    min-width: 0;
  }

  .wd-label {
    min-width: 5.5em;
    font-size: 12px;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .wd-tickets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .wd-chip {
    padding: 2px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 13px;
    color: var(--text);
  }

  .wd-branch {
    margin: 0;
    padding-left: 20px;
    font-size: 12px;
  }

  .wd-branch .wd-chip {
    border-color: var(--accent-text);
    color: var(--accent-text);
  }

  figcaption {
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .wd-label,
    .wd-branch {
      font-size: 16px;
    }
  }
</style>
