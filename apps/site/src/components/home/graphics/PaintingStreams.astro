---
/**
 * Three tickets join: an overlay with the painting's own master size
 * (`viewBox` 1672 by 941, `slice`), so it scales exactly like the
 * cover-fitted picture under it. Light runs down each stream and the river
 * (a blurred glow, a core and a travelling spark), blooms at the waterfall,
 * and an outline chip marks each sample ticket with a green "Merged" badge
 * below the falls. It is rendered in its final state (stage 2);
 * `painting-streams.ts` only sets `data-stage` to draw the earlier stages.
 * No inline styles (the CSP forbids them), so every look lives in
 * `graphics.css`.
 */
// oxlint-disable-next-line import/no-unassigned-import -- Astro bundles a stylesheet imported for its side effect
import "../../../styles/graphics.css";
import { streamPaths, WATERFALL } from "./stream-paths";

interface Props {
  merged: string;
}

const { merged } = Astro.props;

const paths = streamPaths();
const streams = [
  { id: "#43", d: paths.left, source: [603, 627], chip: [606, 582], order: "1" },
  { id: "#44", d: paths.middle, source: [837, 613], chip: [837, 570], order: "2" },
  { id: "#45", d: paths.right, source: [1110, 621], chip: [1066, 586], order: "3" },
] as const;
const layers = ["wide", "mid", "core", "spark"] as const;
const blurs = { wide: "ps-blur-14", mid: "ps-blur-5", spark: "ps-blur-2" } as const;
---

<svg
  class="painting-streams"
  data-streams
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 1672 941"
  preserveAspectRatio="xMidYMid slice"
>
  <defs>
    {
      (["14", "5", "2"] as const).map((deviation) => (
        <filter
          id={`ps-blur-${deviation}`}
          filterUnits="userSpaceOnUse"
          x="0"
          y="0"
          width="1672"
          height="941"
        >
          <feGaussianBlur stdDeviation={deviation} />
        </filter>
      ))
    }
    <radialGradient id="ps-bloom">
      <stop offset="0" stop-color="#fff6bd" stop-opacity="0.95"></stop>
      <stop offset="0.35" stop-color="#ffd45a" stop-opacity="0.5"></stop>
      <stop offset="1" stop-color="#ffd45a" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <g class="ps-light">
    {
      streams.map((stream) =>
        layers.map((layer) => (
          <path
            class={`ps-layer ps-${layer} ps-stream-${stream.order}`}
            d={stream.d}
            pathLength="1"
            filter={layer === "core" ? undefined : `url(#${blurs[layer]})`}
          />
        ))
      )
    }
    {
      layers.map((layer) => (
        <path
          class={`ps-layer ps-${layer} ps-river`}
          d={paths.river}
          pathLength="1"
          filter={layer === "core" ? undefined : `url(#${blurs[layer]})`}
        />
      ))
    }
    <circle class="ps-bloom" cx={WATERFALL[0]} cy={WATERFALL[1]} r="110" fill="url(#ps-bloom)"></circle>
    <circle class="ps-ring" cx={WATERFALL[0]} cy={WATERFALL[1]} r="130"></circle>
  </g>
  {
    streams.map((stream) => (
      <g class="ps-chip">
        <line
          class="ps-stem"
          x1={stream.chip[0]}
          y1={stream.chip[1] + 21}
          x2={stream.source[0]}
          y2={stream.source[1]}
        />
        <circle class="ps-dot" cx={stream.source[0]} cy={stream.source[1]} r="7" />
        <g transform={`translate(${stream.chip[0]} ${stream.chip[1]})`}>
          <rect class="ps-chip-bg" x="-42" y="-21" width="84" height="42" rx="21"></rect>
          <text class="ps-chip-text" y="8" text-anchor="middle">{stream.id}</text>
        </g>
      </g>
    ))
  }
  <g transform="translate(822 842)">
    <g class="ps-merged">
      <rect class="ps-merged-bg" x="-92" y="-22" width="184" height="44" rx="22"></rect>
      <path class="ps-check" d="M-64 1 L-57 8 L-45 -6"></path>
      <text class="ps-merged-text" x="14" y="9" text-anchor="middle">{merged}</text>
    </g>
  </g>
</svg>
