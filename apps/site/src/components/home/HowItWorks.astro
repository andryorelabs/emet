---
/**
 * Three exchanges beside a sticky, fixed crop of the golden-hour painting
 * with the tickets drawn as streams that join. The
 * what the user types stays in code blocks, what emet answers is drawn as
 * output, with sample content; the install banner shows the mascot as the
 * terminal draws it.
 */
import { Picture } from "astro:assets";

import sourceImage from "../../assets/source.webp";
import type { UiStrings } from "../../i18n/ui/en";
import CodeBlock from "../code/CodeBlock.astro";
import PaintingStreams from "./graphics/PaintingStreams.astro";
import PixelMascot from "./graphics/PixelMascot.astro";

interface Props {
  strings: UiStrings;
}

const { strings } = Astro.props;
const { how } = strings;

const claudeCommands = [
  "claude plugin marketplace add andryorelabs/emet",
  "claude plugin install emet@emet-marketplace",
].join("\n");
const codexCommands = [
  "codex plugin marketplace add andryorelabs/emet",
  "codex plugin add emet@emet-marketplace",
].join("\n");
const cloneCommands = [
  "git clone git@github.com:andryorelabs/emet.git",
  "cd emet",
  "./install.sh",
].join("\n");

const banner = [
  "emet  plugin for Claude Code and Codex",
  "Spec to merge, on one approval.",
  "interview, spec, tickets, one approval, merge",
  "Not affiliated with or endorsed by Anthropic or OpenAI",
].join("\n");

const waveOneTickets = [{ id: "#253", name: "monorepo scaffold" }];
const waveTwoTickets = [
  { id: "#254", name: "home layout" },
  { id: "#255", name: "code blocks" },
  { id: "#256", name: "docker and deploy" },
];
---

<section class="how" data-drift="6" aria-labelledby="how-title">
  <figure class="how-painting" aria-hidden="false">
    <Picture
      src={sourceImage}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[640, 1024, 1672]}
      sizes="(min-width: 1001px) 360px, 100vw"
      alt={how.alt}
      loading="lazy"
      decoding="async"
    />
    <PaintingStreams merged={how.merged} />
  </figure>
  <div class="how-column">
    <h2 id="how-title" data-reveal="heading"><span class="reveal-line">{how.heading}</span></h2>

    <article class="exchange" id="install" data-typed>
      <h3>{how.install}</h3>
      <p class="io">{how.youType}</p>
      <CodeBlock
        code={claudeCommands}
        lang="bash"
        tabs={[
          { label: "Claude Code", code: claudeCommands },
          { label: "Codex", code: codexCommands },
          { label: how.tabClone, code: cloneCommands },
        ]}
      />
      <p class="io">{how.emetReplies}</p>
      <div class="fragment banner" data-ui data-reveal="item">
        <PixelMascot />
        <pre class="terminal">{banner}</pre>
      </div>
    </article>

    <article class="exchange" data-typed>
      <h3>{how.describe}</h3>
      <p class="io">{how.youType}</p>
      <CodeBlock
        code={`/emet:run ${how.request}`}
        lang="bash"
        tabs={[
          { label: "Claude Code", code: `/emet:run ${how.request}` },
          { label: "Codex", code: `$emet:run ${how.request}` },
        ]}
      />
      <p class="io">{how.emetReplies}</p>
      <div class="out" data-ui data-reveal="item">
        <p class="out-head"><b>Spec 252 &middot; the Website</b><span>S1 monorepo &middot; S2 site app &middot; S3 home page</span></p>
        <section class="out-group">
          <h4>Wave 1</h4>
          <ul class="out-rows">
            {
              waveOneTickets.map((ticket) => (
                <li class="out-row">
                  <span class="out-mark is-open" aria-hidden="true" />
                  <span class="out-name">{ticket.name}</span>
                  <span class="out-id">{ticket.id}</span>
                </li>
              ))
            }
          </ul>
        </section>
        <section class="out-group">
          <h4>Wave 2 <em>starts after #253</em></h4>
          <ul class="out-rows">
            {
              waveTwoTickets.map((ticket) => (
                <li class="out-row">
                  <span class="out-mark is-open" aria-hidden="true" />
                  <span class="out-name">{ticket.name}</span>
                  <span class="out-id">{ticket.id}</span>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </article>

    <article class="exchange" data-typed>
      <h3>{how.land}</h3>
      <p class="io">{how.youType}</p>
      <CodeBlock code="emet status" lang="bash" />
      <p class="io">{how.emetReplies}</p>
      <div class="out land" data-ui data-reveal="item" data-land>
        <ul class="out-rows" aria-label="Closed tickets">
          {
            waveTwoTickets.map((ticket) => (
              <li class="out-row">
                <span class="out-mark" aria-hidden="true" />
                <span class="out-name">{ticket.name}</span>
                <span class="out-id">{ticket.id}</span>
              </li>
            ))
          }
        </ul>
        <div class="pr-card">
          <p class="pr-title">
            <span class="pr-state">
              <span class="pr-state-open" aria-hidden="true">Open</span>
              <span class="pr-state-merged">Merged</span>
            </span>
            Wave 2: home layout
          </p>
          <p class="pr-meta">Closes #254, #255, #256 &middot; checks passing &middot; reviewed</p>
        </div>
      </div>
    </article>
  </div>
</section>

<script>
  import { initLandCard } from "./graphics/land-card";
  import { initMascot } from "./graphics/mascot-motion";
  import { initPaintingStreams } from "./graphics/painting-streams";
  import { initTypedTerminal } from "./graphics/typed-terminal";

  initTypedTerminal(document);
  initMascot(document);
  initLandCard(document);
  initPaintingStreams(document);
</script>
