---
/**
 * Three steps of a timeline beside a stage painting with the tickets drawn as
 * streams that join. At 901px and wider the section is a pinned runway:
 * `how/pin.ts` expands the active step, collapses the others to their title
 * and eases a dither reveal of the stage. Below that, with reduced motion or
 * without script everything stacks in its final state. What the user types
 * stays in code blocks, what emet answers is drawn as output, with sample
 * content; the install banner shows the mascot as the terminal draws it.
 */
import { getImage, Picture } from "astro:assets";

import sourceImage from "../../assets/source.webp";
import type { Locale } from "../../i18n/locales";
import { DEFAULT_LOCALE, localePath, LOCALES, localeSegment } from "../../i18n/locales";
import type { UiStrings } from "../../i18n/ui/en";
import CodeBlock from "../code/CodeBlock.astro";
import PaintingStreams from "./graphics/PaintingStreams.astro";
import PixelMascot from "./graphics/PixelMascot.astro";
import WaveDiagram from "./WaveDiagram.astro";

interface Props {
  strings: UiStrings;
  locale?: Locale;
}

const { strings, locale: localeProp } = Astro.props;
const { how } = strings;
const locale =
  localeProp ??
  LOCALES.find(
    (candidate) =>
      candidate !== DEFAULT_LOCALE &&
      Astro.url.pathname.startsWith(`/${localeSegment(candidate)}/`),
  ) ??
  DEFAULT_LOCALE;
const installPath = localePath(locale, "/docs/start/install/");

const ditherSource = await getImage({ src: sourceImage, format: "webp", width: 1672 });

const standaloneCommand = "curl -fsSL https://emet.andryore.dev/install.sh | sh";

const banner = [
  "emet  workflow for Claude Code and Codex",
  "Spec to merge, on one approval.",
  "interview, spec, tickets, one approval, merge",
  "Not affiliated with or endorsed by Anthropic or OpenAI",
].join("\n");

const waveOneTickets = [{ id: "#42", name: "theme tokens" }];
const waveTwoTickets = [
  { id: "#43", name: "settings toggle" },
  { id: "#44", name: "remember the choice" },
  { id: "#45", name: "docs and screenshots" },
];
const terminalIcon =
  '<svg class="how-term-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect width="16" height="16" rx="3" fill="currentColor" opacity=".35"/><path d="M4 5l3 3-3 3M8.5 11.5h3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const waveLabel = (number: number): string => how.wave.replace("{n}", String(number));
---

<section class="how" id="how" data-how-pin aria-labelledby="how-title">
  <div class="how-stick">
    <div class="how-column">
      <h2 id="how-title" data-reveal="heading"><span class="reveal-line">{how.heading}</span></h2>

      <article class="exchange step" id="install" data-typed>
        <h3><span class="step-dot" aria-hidden="true"></span>{how.install}</h3>
        <div class="step-body">
          <div class="step-inner">
            <p class="io how-term"><Fragment set:html={terminalIcon} />{how.youType}</p>
            <CodeBlock code={standaloneCommand} lang="bash" />
            <a class="install-more" href={installPath}>{how.otherInstall}</a>
            <p class="io">{how.emetReplies}</p>
            <div class="fragment banner" data-ui data-reveal="item">
              <PixelMascot />
              <pre class="terminal">{banner}</pre>
            </div>
          </div>
        </div>
      </article>

      <article class="exchange step" data-typed>
        <h3><span class="step-dot" aria-hidden="true"></span>{how.describe}</h3>
        <div class="step-body">
          <div class="step-inner">
            <p class="io how-term"><Fragment set:html={terminalIcon} />{how.youType}</p>
            <CodeBlock
              code={`/emet:run ${how.request}`}
              lang="bash"
              tabs={[
                { label: "Claude Code", code: `/emet:run ${how.request}` },
                { label: "Codex", code: `$emet:run ${how.request}` },
              ]}
            />
            <p class="io">{how.emetReplies}</p>
            <div class="out" data-ui data-reveal="item">
              <p class="out-head"><b>Spec 41 &middot; Dark mode for settings</b><span>S1 tokens &middot; S2 toggle &middot; S3 docs</span></p>
              <section class="out-group">
                <h4>{waveLabel(1)}</h4>
                <ul class="out-rows">
                  {
                    waveOneTickets.map((ticket) => (
                      <li class="out-row">
                        <span class="out-mark is-open" aria-hidden="true" />
                        <span class="out-name">{ticket.name}</span>
                        <span class="out-id">{ticket.id}</span>
                      </li>
                    ))
                  }
                </ul>
              </section>
              <section class="out-group">
                <h4>{waveLabel(2)}</h4>
                <ul class="out-rows">
                  {
                    waveTwoTickets.map((ticket) => (
                      <li class="out-row">
                        <span class="out-mark is-open" aria-hidden="true" />
                        <span class="out-name">{ticket.name}</span>
                        <span class="out-id">{ticket.id}</span>
                      </li>
                    ))
                  }
                </ul>
              </section>
            </div>
          </div>
        </div>
      </article>

      <article class="exchange step" data-typed>
        <h3><span class="step-dot" aria-hidden="true"></span>{how.land}</h3>
        <div class="step-body">
          <div class="step-inner">
            <p class="io how-term"><Fragment set:html={terminalIcon} />{how.youType}</p>
            <CodeBlock code="emet status" lang="bash" />
            <p class="io">{how.emetReplies}</p>
            <WaveDiagram waveLabel={waveLabel} caption={how.caption} />
            <div class="out land" data-ui data-reveal="item" data-land>
              <div class="pr-card">
                <p class="pr-title">
                  <span class="pr-state">
                    <span class="pr-state-open" aria-hidden="true">Open</span>
                    <span class="pr-state-merged">{how.merged}</span>
                  </span>
                  {how.prTitle}
                </p>
                <ul class="pr-closes">
                  {["#42", "#43", "#44", "#45"].map((id) => <li><code lang="en" translate="no">Closes {id}</code></li>)}
                </ul>
                <p class="pr-meta">{how.checks}</p>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>

    <figure class="how-painting" data-how-stage>
      <Picture
        src={sourceImage}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        widths={[640, 1024, 1672]}
        sizes="(min-width: 901px) 50vw, 100vw"
        alt={how.alt}
        loading="lazy"
        decoding="async"
      />
      <canvas class="how-dither" data-dither-src={ditherSource.src} aria-hidden="true"></canvas>
      <PaintingStreams merged={how.merged} />
    </figure>
  </div>
</section>

<style>
  .install-more {
    align-self: flex-start;
    font-size: 16px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .pr-closes {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 13px;
    color: var(--text-muted);
  }
</style>

<script>
  import { initLandCard } from "./graphics/land-card";
  import { initMascot } from "./graphics/mascot-motion";
  import { initPaintingStreams } from "./graphics/painting-streams";
  import { initTypedTerminal } from "./graphics/typed-terminal";
  import { initHowPin } from "./how/pin";

  const runway = document.querySelector<HTMLElement>("[data-how-pin]");
  if (runway) initHowPin(runway);
  initTypedTerminal(document);
  initMascot(document);
  initLandCard(document);
  initPaintingStreams(document);
</script>
