---
/**
 * Three exchanges beside a sticky crop of the golden-hour painting. The
 * interface fragments are real emet output with sample content.
 */
import { Picture } from "astro:assets";

import sourceImage from "../../assets/source.webp";
import type { UiStrings } from "../../i18n/ui/en";
import CodeBlock from "../code/CodeBlock.astro";
import WaveDiagram from "./graphics/WaveDiagram.astro";

interface Props {
  strings: UiStrings;
}

const { strings } = Astro.props;
const { how } = strings;

const pluginCommands = [
  "claude plugin marketplace add andryorelabs/emet",
  "claude plugin install emet@emet-marketplace",
].join("\n");
const cloneCommands = [
  "git clone git@github.com:andryorelabs/emet.git",
  "cd emet",
  "./install.sh",
].join("\n");

const banner = [
  "   ▄▀▄▄",
  "     █",
  " ▄██████████▄   emet  plugin for Claude Code",
  " ██ ●    ● ██   Spec to merge, on one approval.",
  " ██   ▬▬   ██   interview, spec, tickets, one approval, merge",
  " ▀▀████████▀▀   Not affiliated with or endorsed by Anthropic",
].join("\n");

const tickets = [
  "Spec 252  the Website",
  "  S1  monorepo   S2  site app   S3  home page",
  "",
  "  #253  monorepo scaffold   wave 1",
  "  #254  home layout         wave 2  blocked by #253",
  "  #255  code blocks         wave 2  blocked by #253",
  "  #256  docker and deploy   wave 2  blocked by #253",
].join("\n");

const statusJson = JSON.stringify(
  {
    state: "ready",
    spec: "252",
    waves: [{ runId: "emet252w2", wave: 2, state: "ready", workers: 3 }],
  },
  null,
  2,
);
---

<section class="how" data-drift="6" aria-labelledby="how-title">
  <figure class="how-painting" aria-hidden="false">
    <Picture
      src={sourceImage}
      formats={["avif", "webp"]}
    fallbackFormat="webp"
      widths={[640, 1024, 1672]}
      sizes="(min-width: 960px) 40vw, 100vw"
      alt={how.alt}
      loading="lazy"
      decoding="async"
    />
  </figure>
  <div class="how-column">
    <h2 id="how-title" data-reveal="heading"><span class="reveal-line">{how.heading}</span></h2>

    <article class="exchange" id="install" data-typed>
      <h3>{how.install}</h3>
      <CodeBlock
        code={pluginCommands}
        lang="bash"
        tabs={[
          { label: how.tabPlugin, code: pluginCommands },
          { label: how.tabClone, code: cloneCommands },
        ]}
      />
    </article>

    <article class="exchange" data-typed>
      <h3>{how.describe}</h3>
      <CodeBlock code={`/emet:run ${how.request}`} lang="bash" />
      <div class="fragment" data-ui data-reveal="item">
        <pre class="terminal">{banner}</pre>
      </div>
      <div class="fragment" data-ui data-reveal="item">
        <pre class="terminal">{tickets}</pre>
        <div class="wave-slot" data-slot="wave-diagram" aria-hidden="true"><WaveDiagram /></div>
      </div>
    </article>

    <article class="exchange" data-typed>
      <h3>{how.land}</h3>
      <CodeBlock code="emet status" lang="bash" />
      <CodeBlock code={statusJson} lang="json" />
      <div class="fragment pr-card" data-ui data-reveal="item">
        <p class="pr-title">
          <span class="pr-state">Merged</span>
          Wave 2: home layout
        </p>
        <p class="pr-meta">Closes #254, #255, #256 &middot; checks passing &middot; reviewed</p>
      </div>
    </article>
  </div>
</section>

<script>
  import { initTypedTerminal } from "./graphics/typed-terminal";

  initTypedTerminal(document);
</script>
