---
/**
 * A code block highlighted at build time with Expressive Code. Without `tabs`,
 * a one-line block is a single-command row and a longer one is an output block
 * with a muted language label; with `tabs` it has a header of pill tabs. Every
 * block has an icon copy button, wired by the bundled client module.
 */
// oxlint-disable-next-line import/no-unassigned-import -- Astro bundles a stylesheet imported for its side effect
import "../../styles/code.css";

import { renderCode } from "../../highlight/render";

interface Props {
  code: string;
  lang?: string;
  tabs?: { label: string; code: string }[];
}

const { code, lang = "text", tabs } = Astro.props;

const hasTabs = tabs !== undefined && tabs.length > 0;
const panels = await Promise.all(
  (hasTabs ? tabs : [{ label: lang, code }]).map(async (panel) => ({
    label: panel.label,
    code: panel.code,
    html: await renderCode(panel.code, lang),
  })),
);
const iconAttributes =
  'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
const copyButton = `<button type="button" class="emet-code__copy" data-copy data-state="idle" aria-label="Copy code"><svg class="emet-code__icon" data-icon="copy" ${iconAttributes}><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg><svg class="emet-code__icon" data-icon="check" ${iconAttributes}><path d="M20 6 9 17l-5-5"/></svg><svg class="emet-code__icon" data-icon="failed" ${iconAttributes}><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>`;
const variant = hasTabs ? "tabs" : code.includes("\n") ? "output" : "command";
const showLabel = variant === "output" && lang !== "text";
---

<div class="emet-code" data-variant={variant} data-code-block>
  {
    hasTabs && (
      <div class="emet-code__header">
        <div class="emet-code__tabs" role="tablist">
          {panels.map((panel, index) => (
            <button
              type="button"
              role="tab"
              class="emet-code__tab"
              data-tab={panel.label}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
            >
              {panel.label}
            </button>
          ))}
        </div>
        <Fragment set:html={copyButton} />
      </div>
    )
  }
  <div class="emet-code__body">
    {
      panels.map((panel, index) => (
        <div
          class="emet-code__panel"
          role={hasTabs ? "tabpanel" : undefined}
          data-panel={panel.label}
          data-code={panel.code}
          hidden={index === 0 ? undefined : true}
        >
          <Fragment set:html={panel.html} />
        </div>
      ))
    }
    {showLabel && <span class="emet-code__label">{lang}</span>}
    {!hasTabs && <Fragment set:html={copyButton} />}
  </div>
  <span class="emet-code__status" role="status" aria-live="polite"></span>
</div>

<script>
  // oxlint-disable-next-line import/no-unassigned-import -- Astro bundles a module imported for its side effect
  import "./code-block-client";
</script>
