{
  "name": "@emet/site",
  "private": true,
  "description": "The emet Website: home page and docs (Astro and Starlight)",
  "homepage": "https://emet.andryore.dev",
  "bugs": {
    "url": "https://github.com/andryorelabs/emet/issues"
  },
  "license": "MIT",
  "author": "Andry Orellana <hello@andryore.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andryorelabs/emet.git",
    "directory": "apps/site"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "bun ../../node_modules/typescript7/bin/tsc --noEmit --runExternalCode -p tsconfig.json",
    "parity": "bun scripts/parity.ts",
    "test:dist": "bun scripts/audit-dist.ts dist",
    "test:e2e": "playwright test",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns 'e2e/**' --coverage --coverage-reporter=text --coverage-reporter=lcov && bun ../../tools/coverage-gate.ts apps/site coverage/lcov.info"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/starlight": "catalog:",
    "@base-ui/react": "^1.9.0",
    "astro": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "expressive-code": "^0.44.3",
    "hast-util-to-html": "^9.0.6",
    "lenis": "^1.3.27",
    "lucide-react": "^1.66.0",
    "motion": "^14.14.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "4.23.0",
    "sharp": "catalog:",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "catalog:",
    "@axe-core/playwright": "4.14.0",
    "@happy-dom/global-registrator": "21.0.4",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
