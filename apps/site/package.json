  "repository": {
    "type": "git",
    "url": "git+https://github.com/andryorelabs/emet.git",
    "directory": "apps/site"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "bun ../../node_modules/typescript7/bin/tsc --noEmit --runExternalCode -p tsconfig.json",
    "test": "bun test --pass-with-no-tests --coverage --coverage-reporter=text --coverage-reporter=lcov && bun ../../tools/coverage-gate.ts apps/site coverage/lcov.info"
  },
  "dependencies": {
    "@astrojs/starlight": "catalog:",
    "astro": "catalog:",
    "expressive-code": "^0.44.3",
    "hast-util-to-html": "^9.0.6",
    "lenis": "^1.3.27",
    "sharp": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "catalog:",
    "@happy-dom/global-registrator": "21.0.4",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:"
  }
}
