{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "FORGE_PREFETCH=1 \"${CLAUDE_PLUGIN_ROOT}/bin/forge\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|ScheduleWakeup|Skill|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/forge\" guard"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/forge\" guard --event SubagentStop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/forge\" guard --event Stop"
          }
        ]
      }
    ]
  }
}
