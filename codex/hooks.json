{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "EMET_AGENT_HOST=codex emet whats-new --hook",
            "commandWindows": "Write-Output '{\"systemMessage\":\"emet does not support native Windows; run Codex inside WSL, or disable the emet plugin.\"}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "EMET_AGENT_HOST=codex emet guard",
            "commandWindows": "exit 0"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "EMET_AGENT_HOST=codex emet guard --event UserPromptSubmit",
            "commandWindows": "exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "EMET_AGENT_HOST=codex emet guard --event Stop",
            "commandWindows": "exit 0"
          }
        ]
      }
    ]
  }
}
