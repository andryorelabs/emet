# emet: runtime state is not versioned; tickets are (local tracker).
.emet/*
!.emet/tickets/
node_modules/

# third-party agent skills installed locally via the skills CLI
.claude/skills/*
!.claude/skills/add-adr/
!.claude/skills/cut-release/
!.claude/skills/git-commit/
skills-lock.json

# turbo cache and Astro generated output
.turbo/
apps/*/.astro/
apps/*/dist/

# design-taste-frontend working files
.taste-skill/
