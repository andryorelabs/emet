# emet: runtime state is not versioned; tickets are (local tracker).
.emet/*
!.emet/tickets/
node_modules/

# third-party agent skills installed locally via the skills CLI; only the two Module skills are tracked (skills-lock.json)
.claude/skills/git-commit/
.claude/worktrees/

# local environment and dotenvx keys
.env
.env.keys

# turbo cache and Astro generated output
.turbo/
apps/*/.astro/
apps/*/dist/

# coverage reports written by `bun run test`
coverage/

# design-taste-frontend working files
.taste-skill/
