{
  "description": "Spec to merge on one approval: parallel workers in isolated worktrees, a review per wave, CI green before merge.",
  "homepage": "https://emet.andryore.dev",
  "default_branch": "main",
  "topics": [
    "agentic-workflow",
    "ai-agents",
    "automation",
    "bun",
    "claude-code",
    "claude-code-plugin",
    "cli",
    "coding-agents",
    "developer-tools",
    "git-worktree",
    "github-issues",
    "linear",
    "typescript"
  ],
  "allow_squash_merge": true,
  "allow_merge_commit": true,
  "allow_rebase_merge": false,
  "squash_merge_commit_title": "PR_TITLE",
  "squash_merge_commit_message": "PR_BODY",
  "merge_commit_title": "PR_TITLE",
  "merge_commit_message": "PR_BODY",
  "delete_branch_on_merge": true,
  "allow_auto_merge": true,
  "allow_update_branch": true,
  "has_wiki": false,
  "has_projects": false,
  "has_discussions": false,
  "secret_scanning": "enabled",
  "secret_scanning_push_protection": "enabled",
  "dependabot_alerts": true,
  "dependabot_security_updates": "enabled",
  "private_vulnerability_reporting": true,
  "default_workflow_permissions": "read",
  "can_approve_pull_request_reviews": false,
  "fork_pr_contributor_approval": "first_time_contributors",
  "code_scanning_default_setup": "not-configured"
}
