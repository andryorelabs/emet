{
  "$schema": "https://emet.andryore.dev/schema/emet.config.schema.json",
  "version": 1,
  "repo": {
    "trunk": "develop",
    "remote": "origin"
  },
  "ticket": {
    "idPattern": "^CLA-\\d+$",
    "branchPrefix": "cla"
  },
  "concurrency": {
    "waveSize": 4,
    "maxLiveWorkers": "auto",
    "runIdleThresholdMs": 5400000
  },
  "tracker": {
    "kind": "github",
    "transitions": {
      "onStart": "worker",
      "onPrOpen": "coordinator",
      "onPrMerge": "coordinator"
    },
    "github": {
      "priorityLabels": {
        "1": "Priority: Critical",
        "2": "Priority: High",
        "3": "Priority: Medium",
        "4": "Priority: Low"
      },
      "stateLabels": {
        "todo": "status:todo",
        "in-progress": "status:in-progress",
        "in-review": "status:in-review"
      }
    }
  },
  "preflight": {
    "requiredFiles": [],
    "requiredCommands": ["gh"]
  },
  "landing": {
    "specMergeMethod": "squash"
  },
  "handoff": {
    "maxLines": 60,
    "maxChars": 8000,
    "autoChain": true,
    "afterSpec": [
      { "paths": ["apps/site/**", "docs/**"], "mode": "promote" },
      { "mode": "release" }
    ]
  },
  "pr": {
    "autoMerge": true,
    "mergeMethod": "squash",
    "maxCiFixAttempts": 2
  },
  "usage": {
    "oversizedReadLines": 400,
    "stalledMinutes": 10
  },
  "models": {
    "worker": { "model": "sonnet", "effort": "medium" },
    "reviewer": {
      "medium": { "model": "opus", "effort": "medium" },
      "high": { "model": "opus", "effort": "medium" }
    },
    "triage": "haiku",
    "escalation": { "sonnet": "opus" }
  },
  "commands": {
    "selfCheck": ["bun run check", "bun run test"],
    "fullSuite": { "run": "bun run check && bun run test" }
  },
  "worktree": {
    "bootstrap": [
      "bun install --frozen-lockfile --silent",
      "bun install --cwd emet --frozen-lockfile --silent"
    ]
  },
  "language": {
    "conversation": "es",
    "artifacts": "en"
  },
  "deploy": {
    "check": {
      "command": "curl -fsS https://emet.andryore.dev/",
      "retries": 20,
      "intervalSeconds": 15,
      "timeoutSeconds": 360,
      "paths": ["apps/site/**", "docs/**"]
    }
  },
  "verify": {
    "browser": {
      "startCommand": "bun run --cwd apps/site dev",
      "url": "http://localhost:4321",
      "paths": ["apps/site/**"]
    }
  },
  "review": {
    "highRiskPaths": ["guard", "settingsapply"]
  },
  "codex": {
    "models": {
      "reviewer": {
        "high": { "model": "gpt-6-luna", "effort": "high", "fallback": ["gpt-5.6-terra"] }
      }
    }
  },
  "validate": {
    "coupledSurfaces": [
      {
        "source": "docs/{start,concepts,how-to,reference}/**/*.md",
        "dependents": "apps/site/src/content/translations/**"
      },
      {
        "source": "docs/troubleshooting.md",
        "dependents": "apps/site/src/content/translations/**"
      }
    ]
  },
  "specs": {
    "enabled": true
  }
}
