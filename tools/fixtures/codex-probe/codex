#!/usr/bin/env bun
import { appendFileSync, readFileSync } from "node:fs";

const argv = process.argv.slice(2);
const logPath = process.env.FAKE_CODEX_PROBE_LOG;
const mode = process.env.FAKE_CODEX_PROBE_MODE ?? "ok";

if (logPath) {
  appendFileSync(logPath, `${JSON.stringify({ argv, codexHome: process.env.CODEX_HOME ?? "" })}\n`);
}

const isModelRun = argv[0] === "exec" && !argv.includes("--help");

/** A minimal `codex execpolicy check --rules <file> <command...>`: prefix rules only. */
function execpolicyCheck(args) {
  const rulesIndex = args.indexOf("--rules");
  const rules = readFileSync(args[rulesIndex + 1], "utf8");
  const command = args.slice(rulesIndex + 2);
  const matchedRules = rules
    .split("\n")
    .flatMap((line) => {
      const match = /prefix_rule\(pattern = (\[.*\]), decision = "(\w+)"\)/.exec(line);
      return match ? [{ pattern: JSON.parse(match[1]), decision: match[2] }] : [];
    })
    .filter(({ pattern }) =>
      pattern.every((token, index) =>
        Array.isArray(token) ? token.includes(command[index]) : token === command[index],
      ),
    )
    .map(({ pattern, decision }) => ({
      prefixRuleMatch: { matchedPrefix: command.slice(0, pattern.length), decision },
    }));
  const decisions = matchedRules.map((rule) => rule.prefixRuleMatch.decision);
  const decision = ["forbidden", "prompt", "allow"].find((name) => decisions.includes(name));
  console.log(JSON.stringify(decision ? { matchedRules, decision } : { matchedRules }));
}

if (argv[0] === "execpolicy" && argv[1] === "check") {
  execpolicyCheck(argv.slice(2));
} else if (argv[0] === "--version") {
  console.log("codex-cli 0.167.0");
} else if (argv[0] === "login" && argv[1] === "status") {
  console.log("Logged in using ChatGPT");
} else if (argv[0] === "plugin" && argv[1] === "list") {
  console.log("PLUGIN                    STATUS          VERSION   SOURCE\n");
} else if (isModelRun && mode === "limit") {
  console.error("ERROR: You've hit your usage limit. Upgrade to Plus or try again later.");
  process.exit(1);
} else if (isModelRun) {
  console.log(JSON.stringify({ type: "thread.started", thread_id: "fake-thread" }));
  console.log(JSON.stringify({ type: "item.completed", item: { type: "agent_message", text: "OK" } }));
  console.log(JSON.stringify({ type: "turn.completed", usage: { input_tokens: 1, output_tokens: 1 } }));
}
